# Copy to .env and fill in. NEVER commit .env.
PRIVATE_KEY=0x...            # deployer key (use a throwaway testnet key)

# --- GIWA Sepolia testnet (chain id 91342) — verified from docs.giwa.io ---
GIWA_RPC_URL=https://sepolia-rpc.giwa.io/
# Flashblocks endpoint gives ~200ms preconfirmations — use it for the live demo:
# GIWA_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io/
GIWA_EXPLORER_API_URL=https://sepolia-explorer.giwa.io/api/
GIWA_EXPLORER_API_KEY=any-nonempty-string   # Blockscout ignores the key
# Faucets (0.005 / 0.01 ETH per day): https://faucet.giwa.io/  |  https://faucet.lambda256.io/giwa-sepolia
